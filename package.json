{
  "name": "nasa-earth-jukebox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-data.mjs",
    "verify": "node scripts/verify.mjs",
    "postinstall": "node -e \"const fs=require('fs'); if(fs.existsSync('node_modules/@rollup/wasm-node/dist')){ fs.cpSync('node_modules/@rollup/wasm-node/dist/wasm-node','node_modules/rollup/dist/wasm-node',{recursive:true}); fs.copyFileSync('node_modules/@rollup/wasm-node/dist/native.js','node_modules/rollup/dist/native.js'); console.log('Applied Rollup WASM patch'); }\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx --yes oxlint src"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.68.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "oxlint": "^0.15.11",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
